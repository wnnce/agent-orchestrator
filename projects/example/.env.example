# Example Environment Variables Template
# Copy this file to .env and fill in the required values:
#   cp .env.example .env

# GitHub Token for Copilot / GitHub MCP
GITHUB_TOKEN=github_pat_xxx

# Database connection URL (if applicable)
DATABASE_URL=postgres://user:password@localhost:5432/example_db

# Custom API Secret / Webhook Key
API_SECRET_KEY=your_secret_key_here

# Secret callers sign feature requests with (hooks/feature-request.ts)
FEATURE_HOOK_SECRET=your_hook_secret_here
